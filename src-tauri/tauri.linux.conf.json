{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      { "title": "Shortwave Atlas", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600, "backgroundColor": "#070d15", "decorations": false }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libhamlib-utils", "libasound2"],
        "conflicts": ["sw-atlas"],
        "replaces": ["sw-atlas"]
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "SW Atlas", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600, "backgroundColor": "#070d15",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --no-proxy-server"
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/rigctld", "binaries/ffmpeg"],
    "resources": {
      "binaries/windows/*.dll": "./",
      "binaries/licenses/**/*": "licenses/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}

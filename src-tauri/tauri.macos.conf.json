{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Shortwave Atlas", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600, "backgroundColor": "#070d15",
        "titleBarStyle": "Overlay", "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/rigctld"],
    "resources": {
      "binaries/licenses/**/*": "licenses/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
